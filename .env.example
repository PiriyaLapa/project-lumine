# =============================================================================
# Project Lumine — Root .env.example
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit it.
# This file (.env.example) is safe to commit — it has no real secrets.
#
# Location: Lumine/.env  (same directory as docker-compose.yml)
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL — used by the mysql:8.0 Docker service
# All four variables must match each other and DATABASE_URL below.
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
MYSQL_DATABASE=lumine
MYSQL_USER=lumine
MYSQL_PASSWORD=change-me-strong-app-password

# -----------------------------------------------------------------------------
# Database URL — used by FastAPI backend (SQLAlchemy)
# Host must be "mysql" (the Docker service name, not localhost).
# User, password, and database must match the four MySQL variables above.
# Format: mysql+pymysql://<MYSQL_USER>:<MYSQL_PASSWORD>@mysql:3306/<MYSQL_DATABASE>
# -----------------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://lumine:change-me-strong-app-password@mysql:3306/lumine

# -----------------------------------------------------------------------------
# JWT Secret Key — used to sign and verify all tokens
# Generate a strong key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# -----------------------------------------------------------------------------
# Google Drive — Phase 4 evidence image storage
# GOOGLE_DRIVE_CREDENTIALS_PATH: path inside the container to credentials.json
# GOOGLE_DRIVE_FOLDER_ID: found in the Drive folder URL
#   drive.google.com/drive/folders/<FOLDER_ID>
# -----------------------------------------------------------------------------
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id-here
