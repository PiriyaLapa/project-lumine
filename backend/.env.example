# Lumine CRM — Environment Variables
# Copy this file to .env and fill in real values before running.
# .env is gitignored — never commit real credentials.

# ------------------------------------------------------------------
# Database — Docker
# Host is the docker-compose service name (mysql), not localhost.
# Change to localhost:3306 if running the backend outside Docker.
# ------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://lumine:lumine@mysql:3306/lumine

# MySQL service credentials — must match DATABASE_URL above.
# Used by the mysql Docker service to initialise the database.
MYSQL_ROOT_PASSWORD=change-me-in-production
MYSQL_DATABASE=lumine
MYSQL_USER=lumine
MYSQL_PASSWORD=lumine

# ------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------
# Generate a strong random key for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ------------------------------------------------------------------
# Google Drive (Phase 4 — evidence image storage)
# ------------------------------------------------------------------
# Path to service account JSON downloaded from Google Cloud Console.
# Required scope: https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials.json

# ID of the Drive folder where evidence images are uploaded.
# Find it in the folder's URL: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here
