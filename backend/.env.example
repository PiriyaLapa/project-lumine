# Lumine CRM — Environment Variables
# Copy this file to .env and fill in real values before running.
# .env is gitignored — never commit real credentials.

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://lumine:lumine@localhost:3306/lumine

# ------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------
# Generate a strong random key for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ------------------------------------------------------------------
# Google Drive (Phase 4 — evidence image storage)
# ------------------------------------------------------------------
# Path to service account JSON downloaded from Google Cloud Console.
# Required scope: https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials.json

# ID of the Drive folder where evidence images are uploaded.
# Find it in the folder's URL: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here
