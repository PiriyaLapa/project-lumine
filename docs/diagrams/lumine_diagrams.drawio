        </mxCell>
        <mxCell id="start" value="Upload SAP export" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1"><mxGeometry x="40" y="100" width="100" height="60" as="geometry" /></mxCell>
        <mxCell id="act1" value="Select file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane1"><mxGeometry x="180" y="100" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="actFix" value="Resolve conflict&#10;or force upsert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane1"><mxGeometry x="380" y="50" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="actView" value="View due&#10;follow-up task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane1"><mxGeometry x="820" y="100" width="140" height="60" as="geometry" /></mxCell>
