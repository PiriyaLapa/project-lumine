        <mxCell id="f18" value="or: tap Skip directly" style="html=1;fontSize=11;" edge="1" parent="1" source="SA_ENT" target="P5_7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="575" /></Array></mxGeometry></mxCell>
        <mxCell id="f19" value="skipped_until = tomorrow" style="html=1;fontSize=11;" edge="1" parent="1" source="P5_7" target="D2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="60" /></Array></mxGeometry></mxCell>

        <mxCell id="note" value="Verified 2026-08-17 against routers/auto_touch.py, services/auto_touch_service.py, repositories/auto_touch_repo.py, services/message_generator.py. 5.4 is checked first — before any DB lookup or dispatch (auto_touch_service.py comment) — so a customer can never receive a message while AUTO_TOUCH_SEND_ENABLED is off, regardless of configured LINE/email credentials. Generate (5.2) and send (5.4/5.5) are always two separate calls — no auto-send is a permanent product rule, not a current limitation." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="1200" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
