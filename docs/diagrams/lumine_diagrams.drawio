  </diagram>
  <diagram name="DFD Level 1 - Lumine" id="dfd1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="SAP" value="SAP System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="SA" value="Sales Associate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="Drive" value="Google Drive" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1080" y="200" width="160" height="60" as="geometry" /></mxCell>

        <mxCell id="P1" value="1.0&#10;Import SAP Data" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="160" height="80" as="geometry" /></mxCell>
        <mxCell id="P2" value="2.0&#10;Schedule Follow-ups" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="160" height="80" as="geometry" /></mxCell>
        <mxCell id="P3" value="3.0&#10;Complete Follow-up" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="340" width="160" height="80" as="geometry" /></mxCell>
        <mxCell id="P4" value="4.0&#10;View Customer Profile" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="500" width="160" height="80" as="geometry" /></mxCell>

        <mxCell id="D1" value="D1  Transactions" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;bottom=1;right=0;left=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="180" height="40" as="geometry" /></mxCell>
        <mxCell id="D2" value="D2  FollowUpTasks" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;bottom=1;right=0;left=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="180" width="180" height="40" as="geometry" /></mxCell>
        <mxCell id="D3" value="D3  EvidenceLogs" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;bottom=1;right=0;left=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="340" width="180" height="40" as="geometry" /></mxCell>
        <mxCell id="D4" value="D4  Customers" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;bottom=1;right=0;left=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="180" height="40" as="geometry" /></mxCell>

        <mxCell id="f1" value="SAP export file" style="html=1;fontSize=11;" edge="1" parent="1" source="SAP" target="P1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="transaction rows" style="html=1;fontSize=11;" edge="1" parent="1" source="P1" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="posting_date" style="html=1;fontSize=11;" edge="1" parent="1" source="D1" target="P2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="2D/2W/2M tasks" style="html=1;fontSize=11;" edge="1" parent="1" source="P2" target="D2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="due tasks" style="html=1;fontSize=11;" edge="1" parent="1" source="D2" target="P3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="photo + notes" style="html=1;fontSize=11;" edge="1" parent="1" source="SA" target="P3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" value="evidence record" style="html=1;fontSize=11;" edge="1" parent="1" source="P3" target="D3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" value="photo upload" style="html=1;fontSize=11;" edge="1" parent="1" source="P3" target="Drive"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" value="task status = Done" style="html=1;fontSize=11;" edge="1" parent="1" source="P3" target="D2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" value="lookup request" style="html=1;fontSize=11;" edge="1" parent="1" source="SA" target="P4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" style="html=1;" edge="1" parent="1" source="D1" target="P4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="f12" style="html=1;" edge="1" parent="1" source="D2" target="P4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="440" /><mxPoint x="440" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="f13" style="html=1;" edge="1" parent="1" source="D4" target="P4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f14" value="purchase + follow-up history" style="html=1;fontSize=11;" edge="1" parent="1" source="P4" target="SA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="540" /></Array></mxGeometry></mxCell>

        <mxCell id="note" value="Level 0 collapses P1-P4 into one &quot;Lumine System&quot; process with the same 3 external entities (SAP, Sales Associate, Google Drive) — open with that, drill into this Level 1 only if asked. Processes verified against routers/upload.py (P1), services/task_scheduler.py (P2), routers/evidence.py (P3), routers/customers.py (P4)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="620" width="700" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="BPMN - Lumine 2-2-2 Lifecycle" id="bpmn1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lane1" value="Sales Associate" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Upload SAP export" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1"><mxGeometry x="40" y="60" width="100" height="60" as="geometry" /></mxCell>
        <mxCell id="act1" value="Select file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane1"><mxGeometry x="180" y="60" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="actFix" value="Resolve conflict&#10;or force upsert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane1"><mxGeometry x="380" y="10" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="actView" value="View due&#10;follow-up task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane1"><mxGeometry x="820" y="60" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="actDo" value="Contact customer,&#10;log evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane1"><mxGeometry x="1000" y="60" width="140" height="60" as="geometry" /></mxCell>

        <mxCell id="lane2" value="System (FastAPI)" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="1200" height="220" as="geometry" />
        </mxCell>
        <mxCell id="parse" value="Parse via&#10;sap_parser.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane2"><mxGeometry x="180" y="20" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="gate" value="Date-range&#10;overlap?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane2"><mxGeometry x="380" y="100" width="120" height="80" as="geometry" /></mxCell>
        <mxCell id="insert" value="Insert Transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane2"><mxGeometry x="560" y="20" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="sched" value="Create 2D / 2W / 2M&#10;FollowUpTasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane2"><mxGeometry x="740" y="20" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="due" value="Task due&#10;today?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane2"><mxGeometry x="820" y="100" width="120" height="80" as="geometry" /></mxCell>
        <mxCell id="wait" value="Stay Pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane2"><mxGeometry x="1000" y="100" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="close" value="Mark task Done,&#10;save EvidenceLog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane2"><mxGeometry x="1000" y="20" width="140" height="60" as="geometry" /></mxCell>

        <mxCell id="endA" value="Cycle closed" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1200" y="105" width="80" height="60" as="geometry" /></mxCell>

        <mxCell id="c1" style="html=1;" edge="1" parent="1" source="start" target="act1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" style="html=1;" edge="1" parent="1" source="act1" target="parse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" style="html=1;" edge="1" parent="1" source="parse" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" value="yes, force=false" style="html=1;fontSize=11;" edge="1" parent="1" source="gate" target="actFix"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" style="html=1;" edge="1" parent="1" source="actFix" target="parse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c6" value="no" style="html=1;fontSize=11;" edge="1" parent="1" source="gate" target="insert"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c7" style="html=1;" edge="1" parent="1" source="insert" target="sched"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c8" style="html=1;" edge="1" parent="1" source="sched" target="due"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c9" value="no" style="html=1;fontSize=11;" edge="1" parent="1" source="due" target="wait"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c10" style="html=1;" edge="1" parent="1" source="wait" target="due"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="360" /><mxPoint x="940" y="360" /></Array></mxGeometry></mxCell>
        <mxCell id="c11" value="yes" style="html=1;fontSize=11;" edge="1" parent="1" source="due" target="actView"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c12" style="html=1;" edge="1" parent="1" source="actView" target="actDo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c13" style="html=1;" edge="1" parent="1" source="actDo" target="close"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c14" style="html=1;" edge="1" parent="1" source="close" target="endA"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Verified 2026-08-17 against routers/upload.py: force=false (default) rejects on overlap and returns a 409-style conflict payload; force=true bypasses the check and upserts. The loop only closes when evidence is logged, not when the due date passes — status stays Pending until a human acts. Shape convention: rounded = start/end event, rectangle = task, diamond = gateway — standard BPMN notation." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="900" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
