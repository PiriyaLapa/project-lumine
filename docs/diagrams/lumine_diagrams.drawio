        <mxCell id="e4" style="html=1;" edge="1" parent="1" source="jwt" target="services"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="html=1;" edge="1" parent="1" source="services" target="repos"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="html=1;" edge="1" parent="1" source="repos" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="evidence photo" style="html=1;fontSize=11;" edge="1" parent="1" source="services" target="drive"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="2-2-2 reminders" style="html=1;fontSize=11;" edge="1" parent="1" source="services" target="line"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="2-2-2 reminders" style="html=1;fontSize=11;" edge="1" parent="1" source="services" target="smtp"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="repositories/ layer, and LINE/SMTP notification channels, verified 2026-08-17 (backend/app/repositories/, services/line_client.py, services/smtp_client.py) — real, not in the earlier draft. CLAUDE.md Rule 7 (SAP never touches MySQL directly) and Repository Pattern (Services -> Repositories -> MySQL, never skip a layer) are enforced project rules, not just diagram theory." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="600" height="80" as="geometry" />
