        <mxCell id="sched" value="Create 2D / 2W / 2M&#10;FollowUpTasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane2"><mxGeometry x="740" y="20" width="140" height="60" as="geometry" /></mxCell>
