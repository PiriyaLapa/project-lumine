        <mxCell id="c11" value="yes" style="html=1;fontSize=11;" edge="1" parent="1" source="due" target="actView"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c12" style="html=1;" edge="1" parent="1" source="actView" target="gateMethod"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c13a" value="manual" style="html=1;fontSize=11;" edge="1" parent="1" source="gateMethod" target="actDo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c13b" value="auto-touch" style="html=1;fontSize=11;" edge="1" parent="1" source="gateMethod" target="actReview"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c13c" value="skip" style="html=1;fontSize=11;" edge="1" parent="1" source="gateMethod" target="actSkip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cManualSys" style="html=1;" edge="1" parent="1" source="actDo" target="close"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c14" style="html=1;" edge="1" parent="1" source="close" target="endA"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cGen" style="html=1;" edge="1" parent="1" source="actReview" target="genDraft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cGenGate" style="html=1;" edge="1" parent="1" source="genDraft" target="gateSend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cGateYes" value="yes" style="html=1;fontSize=11;" edge="1" parent="1" source="gateSend" target="dispatchClose"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cGateNo" value="no" style="html=1;fontSize=11;" edge="1" parent="1" source="gateSend" target="errAuth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cDispatchEnd" style="html=1;" edge="1" parent="1" source="dispatchClose" target="endA"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cErrBack" value="falls back to manual" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="errAuth" target="actDo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cSkipDefer" style="html=1;" edge="1" parent="1" source="actSkip" target="skipDefer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cSkipLoop" value="task stays Pending" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="skipDefer" target="due"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="600" /><mxPoint x="880" y="600" /></Array></mxGeometry></mxCell>

        <mxCell id="note" value="Verified 2026-08-17 against routers/upload.py: force=false (default) rejects on overlap and returns a 409-style conflict payload; force=true bypasses the check and upserts. The loop only closes when evidence is logged (manual) or a message is dispatched (Auto-Touch) — not when the due date passes; status stays Pending until a human acts, or forever if repeatedly skipped. Auto-Touch branch added 2026-08-17, verified against routers/auto_touch.py and services/auto_touch_service.py: the send-gate (AUTO_TOUCH_SEND_ENABLED) is checked before any dispatch and is currently off in production pending company authorization — generate/review always works, send does not. Shape convention: rounded = start/end event, rectangle = task, diamond = gateway — standard BPMN notation." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1200" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="DFD Level 0 - Lumine" id="dfd0">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
