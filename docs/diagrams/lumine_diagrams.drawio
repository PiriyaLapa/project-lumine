        <mxCell id="1" parent="0" />

        <mxCell id="P0" value="0.0&#10;Lumine System" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="280" width="220" height="120" as="geometry" /></mxCell>

        <mxCell id="SAP" value="SAP System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="SA" value="Sales Associate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="120" y="560" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="Drive" value="Google Drive" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="920" y="60" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="LineEnt" value="LINE Messaging API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="920" y="280" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="EmailEnt" value="Email (SMTP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="920" y="350" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="AnthropicEnt" value="Anthropic API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="920" y="440" width="160" height="50" as="geometry" /></mxCell>

        <mxCell id="f1" value="SAP export file" style="html=1;fontSize=11;" edge="1" parent="1" source="SAP" target="P0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="upload / view / evidence / generate / skip" style="html=1;fontSize=11;" edge="1" parent="1" source="SA" target="P0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="queue, reminders, profile, drafts" style="html=1;fontSize=11;" edge="1" parent="1" source="P0" target="SA"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="evidence photo" style="html=1;fontSize=11;" edge="1" parent="1" source="P0" target="Drive"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="push message" style="html=1;fontSize=11;" edge="1" parent="1" source="P0" target="LineEnt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="send email" style="html=1;fontSize=11;" edge="1" parent="1" source="P0" target="EmailEnt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" value="draft request" style="html=1;fontSize=11;" edge="1" parent="1" source="P0" target="AnthropicEnt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" value="draft text" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="AnthropicEnt" target="P0"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Context diagram — collapses all 5 features (Import, Schedule, Complete Follow-up, View Profile, Auto-Touch) into one process against 6 external entities. See 'DFD Level 1 - Lumine' for the 5-process breakdown, and the 5 'DFD Level 2' tabs for each feature's internal steps. Verified 2026-08-17." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="620" width="600" height="60" as="geometry" />
