  </diagram>
  <diagram name="Sequence - Auto-Touch" id="seqAT1">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Participants -->
        <mxCell id="pSA" value="Sales Associate" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="30" height="60" as="geometry" /></mxCell>
        <mxCell id="pApp" value="Mobile App (Expo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="30" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="pAPI" value="FastAPI Router&#10;(auto_touch.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="30" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="pSvc" value="AutoTouchService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="570" y="30" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="pGen" value="MessageGenerator&#10;→ Anthropic API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="780" y="30" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="pChan" value="LINE / SMTP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="990" y="30" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="pDB" value="MySQL / TiDB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1200" y="30" width="150" height="40" as="geometry" /></mxCell>

        <!-- Lifelines -->
        <mxCell id="l1" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="80" as="sourcePoint" /><mxPoint x="35" y="1080" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l2" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="70" as="sourcePoint" /><mxPoint x="225" y="1080" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l3" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="70" as="sourcePoint" /><mxPoint x="435" y="1080" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l4" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="70" as="sourcePoint" /><mxPoint x="645" y="1080" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l5" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="70" as="sourcePoint" /><mxPoint x="855" y="530" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l6" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1065" y="70" as="sourcePoint" /><mxPoint x="1065" y="750" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l7" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1275" y="70" as="sourcePoint" /><mxPoint x="1275" y="1080" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Today-list phase -->
        <mxCell id="m1" value="1. Open Today tab" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="110" as="sourcePoint" /><mxPoint x="225" y="110" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2. GET /auto-touch/today (JWT)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="145" as="sourcePoint" /><mxPoint x="435" y="145" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3. get_today_list(staff_id)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="180" as="sourcePoint" /><mxPoint x="645" y="180" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4. query due tasks (exclude do_not_contact, active skipped_until)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="215" as="sourcePoint" /><mxPoint x="1275" y="215" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5. due/overdue rows, ordered 2D → 2W → 2M" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1275" y="250" as="sourcePoint" /><mxPoint x="645" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6. list[AutoTouchCustomer]" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="285" as="sourcePoint" /><mxPoint x="225" y="285" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Generate phase -->
        <mxCell id="m7" value="7. Tap Generate on a customer" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="320" as="sourcePoint" /><mxPoint x="225" y="320" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8. POST /generate-message {customer_id, task_id}" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="355" as="sourcePoint" /><mxPoint x="435" y="355" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="9. generate_message(...)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="390" as="sourcePoint" /><mxPoint x="645" y="390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="10. generate(customer_name, language, touchpoint, products)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="425" as="sourcePoint" /><mxPoint x="855" y="425" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="11. draft text (PDPA opt-out line hardcoded, never auto-sent)" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="460" as="sourcePoint" /><mxPoint x="645" y="460" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="12. GenerateMessageResponse (draft only)" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="495" as="sourcePoint" /><mxPoint x="225" y="495" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="divider1" value="Associate reviews / edits the draft — generate and send are always two separate calls, no auto-send" style="text;html=1;align=center;fontStyle=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="525" width="1240" height="30" as="geometry" /></mxCell>

        <!-- Send phase -->
        <mxCell id="m13" value="13. Tap Send" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="590" as="sourcePoint" /><mxPoint x="225" y="590" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="14. POST /send/{customer_id} {task_id, message_text, channels}" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="625" as="sourcePoint" /><mxPoint x="435" y="625" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="15. send_message(...)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="660" as="sourcePoint" /><mxPoint x="645" y="660" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="gateNote" value="GATE: AUTO_TOUCH_SEND_ENABLED checked here first — before any DB lookup or dispatch. Raises 403 if off; a customer can never receive a message while this is disabled." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="650" y="685" width="330" height="45" as="geometry" /></mxCell>
        <mxCell id="m16" value="16. dispatch via LINE/SMTP (per available channel)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="745" as="sourcePoint" /><mxPoint x="1065" y="745" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m17" value="17. sent / failed per channel" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1065" y="780" as="sourcePoint" /><mxPoint x="645" y="780" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m18" value="18. INSERT Message row" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="815" as="sourcePoint" /><mxPoint x="1275" y="815" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m19" value="19. UPDATE task.status=Done (only if any channel succeeded)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="850" as="sourcePoint" /><mxPoint x="1275" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m20" value="20. SendMessageResponse (status: sent/partial/failed)" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="885" as="sourcePoint" /><mxPoint x="225" y="885" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="divider2" value="Alternative — associate skips instead of sending" style="text;html=1;align=center;fontStyle=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="920" width="1240" height="30" as="geometry" /></mxCell>

        <!-- Skip phase -->
        <mxCell id="m21" value="21. Tap Skip" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="985" as="sourcePoint" /><mxPoint x="225" y="985" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m22" value="22. POST /skip/{customer_id}" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="1015" as="sourcePoint" /><mxPoint x="435" y="1015" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m23" value="23. skip(customer_id, staff_id) → UPDATE skipped_until = tomorrow" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="1045" as="sourcePoint" /><mxPoint x="1275" y="1045" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m24" value="24. SkipResponse (deferred_to)" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="1075" as="sourcePoint" /><mxPoint x="225" y="1075" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="note" value="Verified 2026-08-17 against routers/auto_touch.py, services/auto_touch_service.py, services/message_generator.py, repositories/auto_touch_repo.py. Generate and send are always two separate calls — no auto-send is a permanent product rule, not a current limitation. The send-gate is checked first, before any DB lookup or dispatch." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="35" y="1095" width="1000" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="DFD Level 2 - Import SAP Data" id="dfd2imp">
    <mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="SAP" value="SAP System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="SA_ENT" value="Sales Associate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="140" height="60" as="geometry" /></mxCell>

        <mxCell id="P1_1" value="1.1&#10;Parse via sap_parser.py&#10;(sap_column_map.json, Rule 7)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="150" width="180" height="100" as="geometry" /></mxCell>
        <mxCell id="P1_2" value="1.2&#10;Date-range&#10;overlap?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="480" y="160" width="140" height="80" as="geometry" /></mxCell>
        <mxCell id="P1_3" value="1.3&#10;Insert Transaction" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="170" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="D1" value="D1  Transactions" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;bottom=1;right=0;left=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="280" width="180" height="40" as="geometry" /></mxCell>
        <mxCell id="P1_4" value="1.4&#10;Hand off to&#10;Cycle Reset" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="920" y="170" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="xref" value="→ see 'DFD Level 2 -&#10;Schedule Follow-ups'" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1130" y="180" width="200" height="40" as="geometry" /></mxCell>

        <mxCell id="f1" value="SAP export file" style="html=1;fontSize=11;" edge="1" parent="1" source="SAP" target="P1_1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="parsed transaction rows" style="html=1;fontSize=11;" edge="1" parent="1" source="P1_1" target="P1_2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="no (or force=true)" style="html=1;fontSize=11;" edge="1" parent="1" source="P1_2" target="P1_3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="yes: 409 conflict (unless force=true)" style="html=1;dashed=1;fontSize=11;fontColor=#b85450;" edge="1" parent="1" source="P1_2" target="SA_ENT"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="transaction row" style="html=1;fontSize=11;" edge="1" parent="1" source="P1_3" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="posting_date, customer_id" style="html=1;fontSize=11;" edge="1" parent="1" source="P1_3" target="P1_4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Verified 2026-08-17 against routers/upload.py, services/sap_parser.py, services/cycle_reset.py. Flow per upload.py's own docstring: 'SAP file → SAPParser (Rule 7) → overlap check → transaction_repo → CycleReset → upload_log_repo → response.' 1.2: force=false (default) rejects on overlap with a 409-style conflict; force=true bypasses and upserts. 1.4 hands off directly into Cycle Reset (supersede-before-schedule) — decomposed in the 'DFD Level 2 - Schedule Follow-ups' tab." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1250" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="DFD Level 2 - Schedule Follow-ups" id="dfd2sched">
    <mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="xrefIn" value="← triggered by Import&#10;(1.4 Hand off to Cycle Reset)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="200" height="40" as="geometry" /></mxCell>

        <mxCell id="D2" value="D2  FollowUpTasks" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;bottom=1;right=0;left=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="180" height="40" as="geometry" /></mxCell>

        <mxCell id="P2_1" value="2.1&#10;Find existing&#10;Pending tasks" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="200" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="P2_2" value="2.2&#10;Supersede if found&#10;(cycles_reset flag)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="200" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="P2_3" value="2.3&#10;Calculate due dates&#10;(2D +2d / 2W +14d / 2M +60d,&#10;from posting_date)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="730" y="190" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="P2_4" value="2.4&#10;Insert 3&#10;FollowUpTask rows" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="980" y="200" width="180" height="70" as="geometry" /></mxCell>

        <mxCell id="f0" style="html=1;dashed=1;" edge="1" parent="1" source="xrefIn" target="P2_1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1" value="existing Pending tasks for customer" style="html=1;fontSize=11;" edge="1" parent="1" source="D2" target="P2_1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="pending task list" style="html=1;fontSize=11;" edge="1" parent="1" source="P2_1" target="P2_2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="status=Superseded" style="html=1;fontSize=11;" edge="1" parent="1" source="P2_2" target="D2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="120" /></Array></mxGeometry></mxCell>
        <mxCell id="f4" value="cycles_reset flag" style="html=1;fontSize=11;" edge="1" parent="1" source="P2_2" target="P2_3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="due_date per task_type" style="html=1;fontSize=11;" edge="1" parent="1" source="P2_3" target="P2_4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="3 new Pending rows" style="html=1;fontSize=11;" edge="1" parent="1" source="P2_4" target="D2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="120" /></Array></mxGeometry></mxCell>

        <mxCell id="note" value="Verified 2026-08-17 against services/cycle_reset.py, services/task_scheduler.py. Order matters: supersede BEFORE schedule — never have both old and new Pending simultaneously (cycle_reset.py comment). Offsets are fixed per SRS §5 FR-02: task_basis is always posting_date, never call date; no weekend/holiday adjustment — due dates display as-is. First purchase (no pending tasks found) skips 2.2 entirely, cycles_reset=0." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="330" width="900" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
