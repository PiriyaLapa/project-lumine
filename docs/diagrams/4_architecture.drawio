<mxfile host="app.diagrams.net">
  <diagram name="Architecture - Lumine" id="arch1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="extBox" value="External Sources" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="220" height="140" as="geometry" /></mxCell>
        <mxCell id="sap" value="SAP Export&#10;(.xlsx / .csv)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="70" y="80" width="160" height="70" as="geometry" /></mxCell>

        <mxCell id="clientBox" value="Mobile Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="220" height="140" as="geometry" /></mxCell>
        <mxCell id="rn" value="React Native (Expo)&#10;TypeScript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="160" height="70" as="geometry" /></mxCell>

        <mxCell id="backendBox" value="FastAPI Backend (Render)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="380" y="40" width="260" height="440" as="geometry" /></mxCell>
        <mxCell id="routers" value="Routers&#10;auth, upload, tasks, evidence,&#10;customers, auto_touch, reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="80" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="jwt" value="JWT Middleware&#10;(python-jose)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="180" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="services" value="Services&#10;sap_parser, task_scheduler,&#10;cycle_reset, evidence_service,&#10;message_generator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="410" y="270" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="repos" value="Repositories&#10;SQLAlchemy ORM&#10;(no raw SQL — repo pattern)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="410" y="380" width="200" height="70" as="geometry" /></mxCell>

        <mxCell id="db" value="MySQL / TiDB Cloud" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="390" width="160" height="80" as="geometry" /></mxCell>

        <mxCell id="drive" value="Google Drive API v3&#10;(evidence photo storage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="720" y="80" width="200" height="70" as="geometry" /></mxCell>

        <mxCell id="notifBox" value="Notification Channels" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="240" height="150" as="geometry" /></mxCell>
        <mxCell id="line" value="LINE Messaging API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="720" y="230" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="smtp" value="SMTP (Email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="720" y="290" width="200" height="50" as="geometry" /></mxCell>

        <mxCell id="e1" value="manual upload" style="html=1;fontSize=11;" edge="1" parent="1" source="sap" target="rn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="HTTPS + JWT" style="html=1;fontSize=11;" edge="1" parent="1" source="rn" target="routers"><mxGeometry relative="1" as="geometry" /></mxCell>
