<mxfile host="app.diagrams.net">
  <diagram name="Sequence - Lumine" id="seq1">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Participants -->
        <mxCell id="pSA" value="Sales Associate" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="30" height="60" as="geometry" /></mxCell>
        <mxCell id="pApp" value="Mobile App (Expo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="30" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="pAPI" value="FastAPI Router&#10;(upload / tasks / evidence)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="30" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="pParser" value="SAPParser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="570" y="30" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="pReset" value="CycleReset" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="770" y="30" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="pSched" value="TaskScheduler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="970" y="30" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="pDB" value="MySQL / TiDB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1170" y="30" width="140" height="40" as="geometry" /></mxCell>

        <!-- Lifelines -->
        <mxCell id="l1" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="80" as="sourcePoint" /><mxPoint x="35" y="880" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l2" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="70" as="sourcePoint" /><mxPoint x="225" y="880" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l3" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="70" as="sourcePoint" /><mxPoint x="435" y="880" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l4" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="70" as="sourcePoint" /><mxPoint x="640" y="500" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l5" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="70" as="sourcePoint" /><mxPoint x="840" y="500" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l6" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="70" as="sourcePoint" /><mxPoint x="1040" y="500" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l7" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="70" as="sourcePoint" /><mxPoint x="1240" y="880" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Upload phase messages -->
        <mxCell id="m1" value="1. Select SAP export file" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="110" as="sourcePoint" /><mxPoint x="225" y="110" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2. POST /upload?force=false (JWT Bearer)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="150" as="sourcePoint" /><mxPoint x="435" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3. parse(file) via sap_column_map.json (Rule 7)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="190" as="sourcePoint" /><mxPoint x="640" y="190" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4. parsed transaction rows" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="225" as="sourcePoint" /><mxPoint x="435" y="225" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5. check date-range overlap (skip if force=true)" style="html=1;fontSize=11;fontColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="260" as="sourcePoint" /><mxPoint x="500" y="260" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6. INSERT transactions" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="295" as="sourcePoint" /><mxPoint x="1240" y="295" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7. CycleReset(transaction)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="330" as="sourcePoint" /><mxPoint x="840" y="330" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8. schedule(db, transaction)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="365" as="sourcePoint" /><mxPoint x="1040" y="365" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="9. INSERT 3x FollowUpTask (2D=+2d / 2W=+14d / 2M=+60d, from posting_date)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="400" as="sourcePoint" /><mxPoint x="1240" y="400" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="10. UploadResponse (tasks_created, cycles_reset)" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="435" as="sourcePoint" /><mxPoint x="225" y="435" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="divider" value="Later — associate closes a task" style="text;html=1;align=center;fontStyle=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="470" width="1205" height="30" as="geometry" /></mxCell>

        <!-- Evidence close phase -->
        <mxCell id="m11" value="11. Open Dashboard, tap task" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="530" as="sourcePoint" /><mxPoint x="225" y="530" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="12. GET /tasks (JWT)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="570" as="sourcePoint" /><mxPoint x="435" y="570" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="13. tasks scoped to staff_id from JWT only (never request body)" style="html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="610" as="sourcePoint" /><mxPoint x="225" y="610" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="14. Submit evidence (photo + notes)" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="650" as="sourcePoint" /><mxPoint x="225" y="650" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="15. POST /evidence" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="690" as="sourcePoint" /><mxPoint x="435" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" value="16. INSERT evidence_log; UPDATE task.status = Done" style="html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="730" as="sourcePoint" /><mxPoint x="1240" y="730" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="note" value="Endpoint paths, force=false query param, JWT-scoped GET /tasks, and 2D/2W/2M offsets (2/14/60 days) verified 2026-08-17 against routers/upload.py, routers/tasks.py, routers/evidence.py, services/task_scheduler.py." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="35" y="800" width="900" height="50" as="geometry" />
        </mxCell>
      </root>
